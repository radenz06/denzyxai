# Contoh konfigurasi auto-denz.py — copy ke env var shell / export.
# Semua opsional; nilai default sudah aman.

# Interval polling notifikasi (detik)
# export DENZYX_AUTO_INTERVAL=30

# Aktifkan balasan AI otomatis (True/False)
# export DENZYX_AUTO_AI=True

# Kirim balasan AI sebagai notifikasi baru (True/False)
# export DENZYX_AUTO_REPLY_NOTIF=True

# Baca balasan pakai TTS (True/False)
# export DENZYX_AUTO_TTS=False

# Vibrate tiap notifikasi baru (True/False)
# export DENZYX_AUTO_VIBRATE=True

# Ambang baterai low (persen)
# export DENZYX_AUTO_BATTERY_LOW=20

# Masa ingat notifikasi (detik) — hindari balas ulang yang sama
# export DENZYX_AUTO_TTL=43200

# App yang di-ignore (pisahkan dengan koma; com.termux.api default)
# export DENZYX_AUTO_IGNORE_APPS=com.termux.api,com.android.systemui

# Path file log daemon
# export DENZYX_AUTO_LOG="$HOME/.denzyx_auto.log"
